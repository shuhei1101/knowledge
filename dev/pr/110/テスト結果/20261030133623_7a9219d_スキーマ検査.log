# validate.py の中身
import sys, glob, os, yaml
from jsonschema import Draft202012Validator
from referencing import Registry, Resource
from referencing.jsonschema import DRAFT202012

root = os.getcwd()
schemas = {}
reg = Registry()
for p in glob.glob('schemas/*.schema.yaml'):
    d = yaml.safe_load(open(p, encoding='utf-8'))
    schemas[os.path.basename(p)] = d
    reg = reg.with_resource(os.path.basename(p), Resource.from_contents(d, DRAFT202012))
    reg = reg.with_resource('file:///' + os.path.basename(p), Resource.from_contents(d, DRAFT202012))

def validate(path):
    doc = yaml.safe_load(open(path, encoding='utf-8'))
    kind = doc.get('kind')
    sch = schemas.get(kind + '.schema.yaml')
    v = Draft202012Validator(sch, registry=reg)
    return [f"{path}: {'/'.join(map(str, e.absolute_path))}: {e.message}" for e in sorted(v.iter_errors(doc), key=lambda e: list(map(str, e.absolute_path)))]

targets = sys.argv[1:] or sorted(glob.glob('docs/**/*.yaml', recursive=True))
bad = 0
n = 0
for t in targets:
    try:
        doc = yaml.safe_load(open(t, encoding='utf-8'))
    except Exception as e:
        print(f'{t}: YAML 読み込み失敗: {e}'); bad += 1; continue
    if not isinstance(doc, dict) or 'kind' not in doc:
        continue
    if doc['kind'] + '.schema.yaml' not in schemas:
        continue
    n += 1
    errs = validate(t)
    for e in errs: print(e)
    bad += bool(errs)
print(f'検査 {n} 件、違反のあるファイル {bad} 件')

# compare_sources.py の中身
import re, subprocess, sys, yaml


def load_old(path):
    """移す前の文書(HEAD~1)を読む。"""
    return yaml.safe_load(subprocess.check_output(['git', 'show', f'HEAD~1:{path}'], text=True, encoding='utf-8'))


def parse_table(body):
    """出典の表の各行を title・url・note に分ける。"""
    rows = []
    for line in body.splitlines():
        m = re.match(r'\| \[(.+?)\]\((\S+?)\) \| (.+) \|$', line)
        if m:
            rows.append({'title': m.group(1), 'url': m.group(2), 'note': m.group(3)})
    return rows


for path in sys.argv[1:]:
    old = load_old(path)
    new = yaml.safe_load(open(path, encoding='utf-8'))
    rows = parse_table(next(i['body'] for i in old['items'] if i['id'] == 'sources-01'))
    moved = [{k: s[k] for k in ('title', 'url', 'note')} for s in new['sources']]
    ids = [i['id'] for i in new['items']]
    keep_old = [i for i in old['items'] if i['id'] != 'sources-01']
    meta_diff = sorted(k for k in set(old) | set(new) if k != 'items' and old.get(k) != new.get(k))
    print(path)
    print(f'  元の出典の表 {len(rows)} 行、sources {len(moved)} 件、title・url・note が一致: {rows == moved}')
    print(f'  rev {old["rev"]} -> {new["rev"]}')
    print(f'  items に sources-01 が残っている: {"sources-01" in ids}')
    print(f'  sources-01 以外の項目は元と同一: {keep_old == new["items"]}')
    print(f'  items を除くメタデータの差分キー: {meta_diff}')
    print(f'  id を持つ sources 要素: {sum(1 for s in new["sources"] if "id" in s)} 件')
