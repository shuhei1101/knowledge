# 突き合わせに使ったスクリプト /tmp/v406/v.py
# /// script
# requires-python = ">=3.14"
# dependencies = ["ruamel.yaml==0.19.1", "yamllint==1.38.0", "jsonschema>=4.26.0"]
# ///
import sys
sys.path.insert(0, sys.argv[1] + "/scripts")
from ruamel.yaml import YAML
import _workflow as w
y = YAML()
schema = y.load(open(sys.argv[1] + "/schemas/design/interface.schema.yaml", encoding="utf-8"))
doc = next(e for e in schema["examples"] if e["id"] == "IF-2")
wf = {"on": {"workflow_dispatch": {"inputs": {"layer": {"type": "choice", "required": True, "options": ["unit", "integration"]}}}},
      "concurrency": {"group": "test-${{ github.ref }}-${{ inputs.layer }}", "cancel-in-progress": True},
      "jobs": {"test": {"steps": [{"name": "ブランチを取得する"}, {"name": "Python と uv を入れる"}, {"name": "層の全件を回す"}, {"name": "ログを成果物に上げる", "if": "${{ always() }}"}]}}}
for f in (w.check_trigger, w.check_request, w.check_exclusivity, w.check_steps):
    print(f.__name__, f(doc, wf))
