$ uv run --no-project --with pyyaml --with jsonschema python /tmp/split/chk.py . /mnt/c/Users/shuhe/repo/ai-monitor/.claude/worktrees/develop
# schemas/design/ のスキーマを ai-monitor と knowledge の dev/設計書/ の設計書へ当てる 1 回限りのコマンド（スクリプトの本体は下）
import yaml,glob,re,sys
from jsonschema import Draft202012Validator as V
from referencing import Registry
from referencing.jsonschema import DRAFT202012
docs={f.split('/')[-1]:yaml.safe_load(open(f,encoding='utf-8')) for f in glob.glob('schemas/design/*.schema.yaml')}
m=V(yaml.safe_load(open('schemas/meta.schema.yaml',encoding='utf-8')))
for f,d in docs.items():
    for e in m.iter_errors(d): print('META',f,list(e.absolute_path),e.message[:100])
# 既存の設計書を種類ごとのスキーマで検査
reg=Registry().with_resources((n,DRAFT202012.create_resource(d)) for n,d in docs.items())
by={d['x-folder']:n for n,d in docs.items() if 'x-folder' in d}
tot=0;bad=0
for root in sys.argv[1:]:
    for f in glob.glob(root+'/dev/設計書/**/*.yaml',recursive=True):
        rel=f[len(root)+1:]
        if rel.endswith('/index.yaml'): s='index.schema.yaml'
        else:
            c=[n for k,n in by.items() if rel.startswith(k+'/') or rel==k+'.yaml']
            if not c: continue
            s=c[0]
        try: d=yaml.safe_load(open(f,encoding='utf-8'))
        except Exception: continue
        v=V({'$ref':s},registry=reg); tot+=1
        for e in v.iter_errors(d):
            bad+=1
            if bad<=12: print(rel,list(e.absolute_path)[:4],e.message[:110])
print('docs',tot,'violations',bad)
