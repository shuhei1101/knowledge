{
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 100,
        "severity": "warning"
      },
      "max-comma": {
        "max": 3,
        "severity": "warning"
      },
      "max-ten": {
        "max": 3,
        "severity": "warning"
      },
      "max-kanji-continuous-len": {
        "max": 6,
        "severity": "warning"
      },
      "arabic-kanji-numbers": {
        "severity": "warning"
      },
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "ですます",
        "preferInList": "である",
        "strict": false,
        "severity": "warning"
      },
      "ja-no-mixed-period": {
        "periodMark": "。",
        "severity": "warning"
      },
      "no-double-negative-ja": {
        "severity": "warning"
      },
      "no-dropping-the-ra": {
        "severity": "warning"
      },
      "no-doubled-conjunctive-particle-ga": {
        "severity": "warning"
      },
      "no-doubled-conjunction": {
        "severity": "warning"
      },
      "no-doubled-joshi": {
        "min_interval": 1,
        "severity": "warning"
      },
      "no-nfd": {
        "severity": "warning"
      },
      "no-invalid-control-character": {
        "severity": "warning"
      },
      "no-zero-width-spaces": {
        "severity": "warning"
      },
      "no-exclamation-question-mark": {
        "severity": "warning"
      },
      "no-hankaku-kana": {
        "severity": "warning"
      },
      "ja-no-weak-phrase": {
        "severity": "warning"
      },
      "ja-no-successive-word": {
        "severity": "warning"
      },
      "ja-no-abusage": {
        "severity": "warning"
      },
      "ja-no-redundant-expression": {
        "severity": "warning"
      },
      "ja-unnatural-alphabet": {
        "severity": "warning"
      },
      "no-unmatched-pair": {
        "severity": "warning"
      }
    },
    "one-sentence-per-line": {
      "severity": "warning"
    }
  }
}
