{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "_description": "書き込んだ中身を AI slop の単語の対応表で照合し、ヒットした単語と置き換え先を additionalContext で通知する。書き込みは止めない",
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use/slop_check.py"
            ]
          }
        ]
      }
    ]
  }
}
